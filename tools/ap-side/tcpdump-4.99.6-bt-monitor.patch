+/*
+ * Linux HCI monitor channel: what the kernel's HCI monitor socket delivers and
+ * what libpcap's pcap-bt-monitor-linux.c saves with this link type.  Each record
+ * is adapter index (2 bytes, network order), opcode (2 bytes, network order)
+ * and the payload.  For HCI packets the payload is the HCI packet without its
+ * type byte: a command is opcode + parameter length + parameters, an event is
+ * event code + parameter length + parameters.
+ *
+ * tcpdump 4.99 no longer dissects HCI, so this prints what BLE advertising
+ * evidence needs - commands, command completion and LE advertising reports - and
+ * one line for everything else; -x shows the bytes of the HCI packet itself.
+ */
+
+#define	BT_MON_HDRLEN		4
+
+/* Opcodes as they are in the capture file (libpcap renumbers a few of them). */
+static const struct tok bt_mon_opcode[] = {
+	{  0, "New Index" },
+	{  1, "Delete Index" },
+	{  2, "HCI Command Packet" },
+	{  3, "HCI Event Packet" },
+	{  4, "ACL Tx Packet" },
+	{  5, "ACL Rx Packet" },
+	{  6, "SCO Tx Packet" },
+	{  7, "SCO Rx Packet" },
+	{  8, "Open Index" },
+	{  9, "Close Index" },
+	{ 10, "Index Info" },
+	{ 11, "Vendor Diagnostic" },
+	{ 12, "System Note" },
+	{ 13, "User Logging" },
+	{ 14, "Control Open" },
+	{ 15, "Control Close" },
+	{ 16, "Control Command" },
+	{ 17, "Control Event" },
+	{ 18, "ISO Tx Packet" },
+	{ 19, "ISO Rx Packet" },
+	{  0, NULL }
+};
+
+static const struct tok bt_dev_bus[] = {
+	{ 0, "virtual" },
+	{ 1, "USB" },
+	{ 2, "PCI" },
+	{ 3, "UART" },
+	{ 4, "BCSP" },
+	{ 5, "SDIO" },
+	{ 6, "SPI" },
+	{ 7, "I2C" },
+	{ 0, NULL }
+};
+
